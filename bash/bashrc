# shellcheck shell=bash disable=SC1090,SC1091
# Additive Bash configuration for Omarchy and other Bash-based environments.
# This file is sourced from ~/.bashrc; it does not replace the host's startup file.

case $- in
    *i*) ;;
    *) return ;;
esac

export DOTFILES="${DOTFILES:-$HOME/dotfiles}"

for file in "$DOTFILES/system/.path" "$DOTFILES/system/.exports" "$DOTFILES/system/.aliases" "$DOTFILES/system/.functions" "$DOTFILES/system/.extra"; do
    [ -r "$file" ] && . "$file"
done

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi

if command -v starship >/dev/null 2>&1; then
    # Omarchy re-renders this from the active theme's accent colour on every
    # theme switch; starship re-reads it each prompt, so open shells follow along.
    [ -r "$HOME/.local/state/omarchy/current/theme/starship.toml" ] &&
        export STARSHIP_CONFIG="$HOME/.local/state/omarchy/current/theme/starship.toml"
    eval "$(starship init bash)"
fi

if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)"
fi

# shellcheck shell=bash disable=SC1090,SC1091
# Additive Bash configuration for Omarchy and other Bash-based environments.
# This file is sourced from ~/.bashrc; it does not replace the host's startup file.

case $- in
    *i*) ;;
    *) return ;;
esac

export DOTFILES="${DOTFILES:-$HOME/dotfiles}"

for file in "$DOTFILES/system/.path" "$DOTFILES/system/.exports" "$DOTFILES/system/.aliases" "$DOTFILES/system/.functions"; do
    [ -r "$file" ] && . "$file"
done

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi

if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
fi

if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)"
fi

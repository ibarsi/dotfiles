# shellcheck shell=bash disable=SC1090,SC1091
# Additive Bash configuration for Omarchy and other Bash-based environments.
# This file is sourced from ~/.bashrc; it does not replace the host's startup file.

case $- in
    *i*) ;;
    *) return ;;
esac

export DOTFILES="${DOTFILES:-$HOME/dotfiles}"

# Palette tokens plus FZF/bat/eza/less colors. Filename is historical; the
# file is POSIX exports that Bash can source.
[ -r "$DOTFILES/theme/catppuccin.zsh" ] && . "$DOTFILES/theme/catppuccin.zsh"

for file in "$DOTFILES/system/.path" "$DOTFILES/system/.exports" "$DOTFILES/system/.aliases" "$DOTFILES/system/.functions" "$DOTFILES/system/.extra"; do
    [ -r "$file" ] && . "$file"
done

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi

if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
fi

if command -v mise >/dev/null 2>&1; then
    # A parent (herdr, uwsm) can hand us a PATH with mise tool dirs already
    # behind /usr/bin; mise leaves such entries where they are, so system
    # binaries shadow the pinned ones and the repo toolchain guard refuses to
    # run. Drop them so activate re-adds them ahead of system paths.
    PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v -E '/mise/installs/' | paste -sd: -)
    eval "$(mise activate bash)"
fi

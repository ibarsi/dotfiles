#!/usr/bin/env bash
# Pushes cmux-style $pr, $review, $merge and $ports workspace tokens into herdr's sidebar.
# Rendered via [ui.sidebar.spaces] rows in ~/.config/herdr/config.toml.
set -u
TICK=${HERDR_SIDEBAR_TICK:-5}          # ports refresh
PR_EVERY=${HERDR_SIDEBAR_PR_EVERY:-12} # PR refresh every N ticks (gh hits the API)

# Prints the PR number plus an invisible zero-width marker for its state,
# since config.toml rules can only colour $pr by matching its text.
# Markers must not be Grapheme_Extend (U+200C/U+200D are): herdr glues those
# onto the last digit and mangles it.
# U+200B merged, U+2062 CI failed, U+2061 CI running, U+2060 CI passed
# Then "|"-separated $review (✓ approved, ✗ changes requested) and $merge
# (↯ conflict, ≡ in merge queue, which hides $review) icons, empty unless
# the PR is open.
pr_summary() {
	local pr review merge num
	# shellcheck disable=SC2016 # $c is a jq variable
	IFS='|' read -r pr review merge num < <(gh pr view --json number,state,reviewDecision,mergeable,statusCheckRollup --jq '
    # A re-triggered workflow leaves the older run in the rollup, and the new
    # run may skip jobs, so keep only the latest run (highest id) per workflow
    def run: [.detailsUrl // "" | scan("/runs/([0-9]+)")[0] | tonumber] | first // 0;
    (.statusCheckRollup | group_by(.workflowName // .context)
      | map((map(run) | max) as $r | .[] | select(run == $r) | .conclusion // .state)) as $c |
    "#\(.number)" +
    (if .state == "MERGED" then "\u200b"
     elif ($c | length) == 0 then ""
     elif any($c[]; . == "FAILURE" or . == "ERROR" or . == "TIMED_OUT") then "\u2062"
     elif any($c[]; . == "PENDING" or . == "IN_PROGRESS" or . == "QUEUED" or . == "" or . == null) then "\u2061"
     else "\u2060" end) as $pr |
    if .state != "OPEN" then "\($pr)|||" else
      "\($pr)|" +
      ({APPROVED: "✓", CHANGES_REQUESTED: "✗"}[.reviewDecision // ""] // "") +
      "|\(if .mergeable == "CONFLICTING" then "↯" else "" end)|\(.number)" end' 2>/dev/null) || return
	# gh pr view has no merge queue field; a conflicting PR can't be queued
	if [ -n "$num" ] && [ -z "$merge" ]; then
		# shellcheck disable=SC2016 # GraphQL variables
		merge=$(gh api graphql -F owner='{owner}' -F name='{repo}' -F n="$num" -f query='
      query($owner: String!, $name: String!, $n: Int!) {
        repository(owner: $owner, name: $name) { pullRequest(number: $n) { mergeQueueEntry { state } } }
      }' --jq 'if .data.repository.pullRequest.mergeQueueEntry then "≡" else "" end' 2>/dev/null)
		# Queued implies approved, so the review icon is noise
		[ "$merge" = "≡" ] && review=
	fi
	echo "$pr|$review|$merge"
}

# report <ws> <source> <ttl-ms> <token>=<value>...; empty value clears the token
report() {
	local ws=$1 src=$2 ttl=$3 kv tok=()
	shift 3
	for kv; do
		if [ -n "${kv#*=}" ]; then tok+=(--token "$kv"); else tok+=(--clear-token "${kv%%=*}"); fi
	done
	herdr workspace report-metadata "$ws" --source "$src" --ttl-ms "$ttl" "${tok[@]}" >/dev/null
}

update_prs() {
	herdr pane list 2>/dev/null |
		jq -r '[.result.panes[] | {workspace_id, cwd}] | unique_by(.workspace_id)[] | "\(.workspace_id)\t\(.cwd)"' |
		while IFS=$'\t' read -r ws cwd; do
			IFS='|' read -r pr review merge < <(cd "$cwd" 2>/dev/null && pr_summary)
			# TTL outlives two refreshes so a dead feeder clears stale values
			report "$ws" sidebar-pr $((TICK * PR_EVERY * 2500)) "pr=${pr:-}" "review=${review:-}" "merge=${merge:-}"
		done
}

# Prints "L <pid> <port>" per listening TCP socket. ss is Linux-only and
# Omarchy ships no lsof; macOS ships no ss.
listeners() {
	if [ "$(uname -s)" = Darwin ]; then
		lsof -nP -iTCP -sTCP:LISTEN -Fpn 2>/dev/null |
			awk '/^p/ { pid = substr($0, 2) } /^n/ { n = split($0, a, ":"); print "L", pid, a[n] }'
	else
		ss -ltnpH 2>/dev/null | awk '{n = split($4, a, ":"); port = a[n]
      while (match($0, /pid=[0-9]+/)) { print "L", substr($0, RSTART+4, RLENGTH-4), port; $0 = substr($0, RSTART+RLENGTH) }}'
	fi
}

# Credits each listening TCP port to the workspace whose pane shell is an
# ancestor of the listening process. Docker-published ports are owned by
# dockerd, not a pane descendant, so they don't show.
update_ports() {
	local shells
	shells=$(herdr pane list 2>/dev/null | jq -r '.result.panes[] | "\(.pane_id)\t\(.workspace_id)"' |
		while IFS=$'\t' read -r pane ws; do
			herdr pane process-info --pane "$pane" 2>/dev/null |
				jq -r --arg ws "$ws" '"S \(.result.process_info.shell_pid) \($ws)"'
		done)
	{
		echo "$shells"
		ps -e -o pid=,ppid= | awk '{print "P", $1, $2}'
		listeners
	} | awk '
    $1 == "S" { shell[$2] = $3; all[$3] = 1 }
    $1 == "P" { parent[$2] = $3 }
    $1 == "L" { for (p = $2; p > 1; p = parent[p]) if (p in shell) { seen[shell[p], $3] = 1; break } }
    END {
      for (k in seen) { split(k, a, SUBSEP); ports[a[1]] = ports[a[1]] (ports[a[1]] ? "," : "") a[2] }
      for (ws in all) print ws "\t" ports[ws]
    }' |
		while IFS=$'\t' read -r ws ports; do
			report "$ws" sidebar-ports $((TICK * 2500)) "ports=${ports:+:$ports}"
		done
}

i=0
while :; do
	((i++ % PR_EVERY == 0)) && update_prs
	update_ports
	sleep "$TICK"
done

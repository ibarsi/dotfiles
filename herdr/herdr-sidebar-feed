#!/usr/bin/env bash
# Pushes cmux-style $pr, $review, $comment, $merge, $deploy and $ports workspace tokens into herdr's sidebar.
# PR tokens for all workspaces come from one batched GraphQL query per refresh.
# Rendered via [ui.sidebar.spaces] rows in ~/.config/herdr/config.toml.
set -u
TICK=${HERDR_SIDEBAR_TICK:-5}          # ports refresh
PR_EVERY=${HERDR_SIDEBAR_PR_EVERY:-12} # PR refresh every N ticks (gh hits the API)
# GitHub environment each PR deploys to, {n} is the PR number. Looked up by
# environment, not commit, because rebasing orphans the deployed SHA.
DEPLOY_ENV=${HERDR_SIDEBAR_DEPLOY_ENV:-"max1-dev-pr-{n}"}

# One GraphQL query per refresh covers every workspace: each distinct
# repo+branch gets an aliased repository() block, so the cost stays ~1 point
# however many workspaces are open.
# shellcheck disable=SC2016 # GraphQL variables and jq variables
PR_FRAGMENT='fragment P on PullRequest {
  number state reviewDecision mergeable
  author { login }
  mergeQueueEntry { state }
  reviews(last: 100) { nodes { author { login } submittedAt } }
  commits(last: 100) { nodes { commit { committedDate messageHeadline } } }
  # Rollup state covers every check; contexts pages at 100, which big PRs exceed
  head: commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
}'

# Prints "<index>\t<pr>|<review>|<comment>|<merge>|<deploy>|<number>" per
# aliased repository r<index> that has a PR. <pr> is the number plus an
# invisible zero-width marker for its state, since config.toml rules can only
# colour $pr by matching its text.
# Markers must not be Grapheme_Extend (U+200C/U+200D are): herdr glues those
# onto the last digit and mangles it.
# U+200B merged, U+2062 CI failed, U+2061 CI running, U+2060 CI passed
# Then $review (✓ approved, ✗ changes requested), $comment (※ someone else
# reviewed after your last non-merge commit) and $merge (↯ conflict, ≡ in
# merge queue, which hides $review) icons, empty unless the PR is open, and
# $deploy for the latest deployment to its $DEPLOY_ENV (▲ live, △ in
# progress, ▼ failed, ▵ replaced by a newer deploy).
# shellcheck disable=SC2016 # jq variables
PR_JQ='
  .data | to_entries[] | (.key[1:]) as $i | .value |
  ({SUCCESS: "▲", IN_PROGRESS: "△", QUEUED: "△", PENDING: "△", WAITING: "△",
    FAILURE: "▼", ERROR: "▼", INACTIVE: "▵"}
   [.deployments.nodes[0].latestStatus.state // ""] // "") as $deploy |
  # Prefer an open PR for the branch, else the newest one
  (.pullRequests.nodes | map(select(.state == "OPEN"))[0] // .[0]) // empty |
  "#\(.number)" +
  (if .state == "MERGED" then "\u200b"
   else {FAILURE: "\u2062", ERROR: "\u2062", PENDING: "\u2061", EXPECTED: "\u2061", SUCCESS: "\u2060"}
     [.head.nodes[0].commit.statusCheckRollup.state // ""] // "" end) as $pr |
  if .state != "OPEN" then "\($i)\t\($pr)|||||" else
    (if .mergeable == "CONFLICTING" then "↯" elif .mergeQueueEntry then "≡" else "" end) as $merge |
    # Queued implies approved, so the review icon is noise
    (if $merge == "≡" then "" else {APPROVED: "✓", CHANGES_REQUESTED: "✗"}[.reviewDecision // ""] // "" end) as $review |
    # Same "since" rule as gh reviews
    (.author.login as $me
      | ([.commits.nodes[].commit | select(.messageHeadline | test("^Merge ") | not) | .committedDate] | max) as $push
      | if any(.reviews.nodes[]; .author.login != $me and .submittedAt > $push) then "※" else "" end) as $comment |
    "\($i)\t\($pr)|\($review)|\($comment)|\($merge)|\($deploy)|\(.number)" end'

# Prints "<owner> <repo> <branch>" for the GitHub repo checked out at $1,
# using the upstream branch name when set. Local git only, no API calls.
pr_key() {
	local url branch
	url=$(git -C "$1" remote get-url origin 2>/dev/null) || return
	case $url in *github.com[:/]*) ;; *) return ;; esac
	url=${url#*github.com[:/]}
	url=${url%.git}
	if branch=$(git -C "$1" rev-parse --abbrev-ref '@{u}' 2>/dev/null); then
		branch=${branch#*/}
	else
		branch=$(git -C "$1" symbolic-ref --short -q HEAD) || return
	fi
	echo "${url%%/*} ${url#*/} $branch"
}

# report <ws> <source> <ttl-ms> <token>=<value>...; empty value clears the token
report() {
	local ws=$1 src=$2 ttl=$3 kv tok=()
	shift 3
	for kv; do
		if [ -n "${kv#*=}" ]; then tok+=(--token "$kv"); else tok+=(--clear-token "${kv%%=*}"); fi
	done
	herdr workspace report-metadata "$ws" --source "$src" --ttl-ms "$ttl" "${tok[@]}" >/dev/null
}

# PR number per repo+branch from the last refresh. Deployments are looked up
# by environment, not commit, because rebasing orphans the deployed SHA, and
# the environment name needs the number.
# ponytail: a new PR's $deploy appears one refresh late, a second round-trip
# per refresh would close that gap
declare -A PR_NUMS=()

update_prs() {
	local ws cwd key i owner repo branch decl='' q='' out line l pr review comment merge deploy
	local -A ws_key=() idx=() res=()
	local -a keys=() vars=()
	while IFS=$'\t' read -r ws cwd; do
		key=$(pr_key "$cwd")
		# A workspace's panes can sit on different branches (a main checkout
		# beside a worktree), so keep every pane's key
		ws_key[$ws]+=${key:+$key$'\n'}
		if [ -n "$key" ] && [ -z "${idx[$key]:-}" ]; then
			idx[$key]=${#keys[@]}
			keys+=("$key")
		fi
	done < <(herdr pane list 2>/dev/null |
		jq -r '[.result.panes[] | {workspace_id, cwd}] | unique[] | "\(.workspace_id)\t\(.cwd)"')

	for i in "${!keys[@]}"; do
		read -r owner repo branch <<<"${keys[i]}"
		vars+=(-f "o$i=$owner" -f "n$i=$repo" -f "b$i=$branch")
		decl+="\$o$i: String!, \$n$i: String!, \$b$i: String!, "
		q+="r$i: repository(owner: \$o$i, name: \$n$i) {
      pullRequests(headRefName: \$b$i, first: 5, orderBy: {field: CREATED_AT, direction: DESC}) { nodes { ...P } }"
		if [ -n "${PR_NUMS[${keys[i]}]:-}" ]; then
			vars+=(-f "e$i=${DEPLOY_ENV//\{n\}/${PR_NUMS[${keys[i]}]}}")
			decl+="\$e$i: String!, "
			q+=" deployments(environments: [\$e$i], last: 1) { nodes { latestStatus { state } } }"
		fi
		q+=" }"$'\n'
	done

	if [ ${#keys[@]} -gt 0 ]; then
		# On failure (rate limit, offline) report nothing and let the TTL clear stale values
		out=$(gh api graphql "${vars[@]}" -f query="query(${decl%, }) { $q } $PR_FRAGMENT" --jq "$PR_JQ" 2>/dev/null) || return
		while IFS=$'\t' read -r i line; do
			[ -n "$i" ] || continue
			res[$i]=$line
			PR_NUMS[${keys[i]}]=${line##*|}
		done <<<"$out"
	fi

	for ws in "${!ws_key[@]}"; do
		# First pane branch with an open PR wins, else the first with any PR
		line=
		while read -r key; do
			[ -n "$key" ] || continue
			l=${res[${idx[$key]}]:-}
			[ -n "$l" ] && [ -z "$line" ] && line=$l
			[ -n "${l##*|}" ] && line=$l && break
		done <<<"${ws_key[$ws]}"
		IFS='|' read -r pr review comment merge deploy _ <<<"$line"
		# TTL outlives two refreshes so a dead feeder clears stale values
		report "$ws" sidebar-pr $((TICK * PR_EVERY * 2500)) "pr=${pr:-}" "review=${review:-}" "comment=${comment:-}" "merge=${merge:-}" "deploy=${deploy:-}"
	done
}

# Prints "L <pid> <port>" per listening TCP socket. ss is Linux-only and
# Omarchy ships no lsof; macOS ships no ss.
listeners() {
	if [ "$(uname -s)" = Darwin ]; then
		lsof -nP -iTCP -sTCP:LISTEN -Fpn 2>/dev/null |
			awk '/^p/ { pid = substr($0, 2) } /^n/ { n = split($0, a, ":"); print "L", pid, a[n] }'
	else
		ss -ltnpH 2>/dev/null | awk '{n = split($4, a, ":"); port = a[n]
      while (match($0, /pid=[0-9]+/)) { print "L", substr($0, RSTART+4, RLENGTH-4), port; $0 = substr($0, RSTART+RLENGTH) }}'
	fi
}

# Credits each listening TCP port to the workspace whose pane shell is an
# ancestor of the listening process. Docker-published ports are owned by
# dockerd, not a pane descendant, so they don't show.
update_ports() {
	local shells
	shells=$(herdr pane list 2>/dev/null | jq -r '.result.panes[] | "\(.pane_id)\t\(.workspace_id)"' |
		while IFS=$'\t' read -r pane ws; do
			herdr pane process-info --pane "$pane" 2>/dev/null |
				jq -r --arg ws "$ws" '"S \(.result.process_info.shell_pid) \($ws)"'
		done)
	{
		echo "$shells"
		ps -e -o pid=,ppid= | awk '{print "P", $1, $2}'
		listeners
	} | awk '
    $1 == "S" { shell[$2] = $3; all[$3] = 1 }
    $1 == "P" { parent[$2] = $3 }
    $1 == "L" { for (p = $2; p > 1; p = parent[p]) if (p in shell) { seen[shell[p], $3] = 1; break } }
    END {
      for (k in seen) { split(k, a, SUBSEP); ports[a[1]] = ports[a[1]] (ports[a[1]] ? "," : "") a[2] }
      for (ws in all) print ws "\t" ports[ws]
    }' |
		while IFS=$'\t' read -r ws ports; do
			report "$ws" sidebar-ports $((TICK * 2500)) "ports=${ports:+:$ports}"
		done
}

i=0
while :; do
	((i++ % PR_EVERY == 0)) && update_prs
	update_ports
	sleep "$TICK"
done

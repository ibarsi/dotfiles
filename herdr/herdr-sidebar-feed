#!/usr/bin/env bash
# Pushes cmux-style $pr and $ports workspace tokens into herdr's sidebar.
# Rendered via [ui.sidebar.spaces] rows in ~/.config/herdr/config.toml.
set -u
TICK=${HERDR_SIDEBAR_TICK:-5}          # ports refresh
PR_EVERY=${HERDR_SIDEBAR_PR_EVERY:-12} # PR refresh every N ticks (gh hits the API)

# Prints "#N <icon>" so config.toml can colour $pr by matching the glyph.
# Width-1 icons, not format characters: herdr draws Cf markers on the last digit.
# Required checks only — statusCheckRollup keeps superseded and optional FAILURE rows.
# ⤮ merged, ✗ required failed/cancelled, … required pending, ✓ required passed
pr_summary() {
	local view number state checks icon
	view=$(gh pr view --json number,state 2>/dev/null) || return
	number=$(jq -r '.number' <<<"$view")
	state=$(jq -r '.state' <<<"$view")
	[ -n "$number" ] && [ "$number" != null ] || return
	if [ "$state" = MERGED ]; then
		printf '#%s ⤮\n' "$number"
		return
	fi
	checks=$(gh pr checks --required --json bucket 2>/dev/null) || true
	if ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"${checks:-}"; then
		printf '#%s\n' "$number"
		return
	fi
	icon=$(jq -r '
		map(.bucket) as $b |
		if ($b | length) == 0 then ""
		elif any($b[]; . == "fail" or . == "cancel") then " ✗"
		elif any($b[]; . == "pending") then " …"
		else " ✓"
		end' <<<"$checks")
	printf '#%s%s\n' "$number" "$icon"
}

# report <ws> <source> <ttl-ms> <token>=<value>...; empty value clears the token
report() {
	local ws=$1 src=$2 ttl=$3 kv tok=()
	shift 3
	for kv; do
		if [ -n "${kv#*=}" ]; then tok+=(--token "$kv"); else tok+=(--clear-token "${kv%%=*}"); fi
	done
	herdr workspace report-metadata "$ws" --source "$src" --ttl-ms "$ttl" "${tok[@]}" >/dev/null
}

update_prs() {
	herdr pane list 2>/dev/null |
		jq -r '[.result.panes[] | {workspace_id, cwd}] | unique_by(.workspace_id)[] | "\(.workspace_id)\t\(.cwd)"' |
		while IFS=$'\t' read -r ws cwd; do
			pr=$(cd "$cwd" 2>/dev/null && pr_summary)
			# TTL outlives two refreshes so a dead feeder clears stale values
			report "$ws" sidebar-pr $((TICK * PR_EVERY * 2500)) "pr=${pr:-}"
		done
}

# Prints "L <pid> <port>" per listening TCP socket. ss is Linux-only and
# Omarchy ships no lsof; macOS ships no ss.
listeners() {
	if [ "$(uname -s)" = Darwin ]; then
		lsof -nP -iTCP -sTCP:LISTEN -Fpn 2>/dev/null |
			awk '/^p/ { pid = substr($0, 2) } /^n/ { n = split($0, a, ":"); print "L", pid, a[n] }'
	else
		ss -ltnpH 2>/dev/null | awk '{n = split($4, a, ":"); port = a[n]
      while (match($0, /pid=[0-9]+/)) { print "L", substr($0, RSTART+4, RLENGTH-4), port; $0 = substr($0, RSTART+RLENGTH) }}'
	fi
}

# Credits each listening TCP port to the workspace whose pane shell is an
# ancestor of the listening process. Docker-published ports are owned by
# dockerd, not a pane descendant, so they don't show.
update_ports() {
	local shells
	shells=$(herdr pane list 2>/dev/null | jq -r '.result.panes[] | "\(.pane_id)\t\(.workspace_id)"' |
		while IFS=$'\t' read -r pane ws; do
			herdr pane process-info --pane "$pane" 2>/dev/null |
				jq -r --arg ws "$ws" '"S \(.result.process_info.shell_pid) \($ws)"'
		done)
	{
		echo "$shells"
		ps -e -o pid=,ppid= | awk '{print "P", $1, $2}'
		listeners
	} | awk '
    $1 == "S" { shell[$2] = $3; all[$3] = 1 }
    $1 == "P" { parent[$2] = $3 }
    $1 == "L" { for (p = $2; p > 1; p = parent[p]) if (p in shell) { seen[shell[p], $3] = 1; break } }
    END {
      for (k in seen) { split(k, a, SUBSEP); ports[a[1]] = ports[a[1]] (ports[a[1]] ? "," : "") a[2] }
      for (ws in all) print ws "\t" ports[ws]
    }' |
		while IFS=$'\t' read -r ws ports; do
			report "$ws" sidebar-ports $((TICK * 2500)) "ports=${ports:+:$ports}"
		done
}

update_prs
i=0
while :; do
	update_ports
	sleep "$TICK"
	((++i % PR_EVERY == 0)) && update_prs
done

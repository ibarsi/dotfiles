[Unit]
Description=llama.cpp router server (Muse-Glimmer)
After=network.target

[Service]
Type=simple
User=ibarsi
ExecStart=/usr/bin/llama-server \
  --models-dir /home/ibarsi/models \
  --models-preset /home/ibarsi/models/presets.ini \
  --device CUDA0 \
  --host 127.0.0.1 --port 1234
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
